{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -F dashboard build",
    "check": "pnpm -r --parallel typecheck",
    "deploy": "pnpm deploy:proxy && pnpm deploy:tail && pnpm deploy:api && pnpm deploy:dispatch",
    "deploy:api": "pnpm -F api migrate && pnpm -F api run deploy",
    "deploy:dashboard": "pnpm -F dashboard run deploy",
    "deploy:dispatch": "pnpm -F dispatch run deploy",
    "deploy:proxy": "pnpm -F proxy run deploy",
    "deploy:staging": "pnpm deploy:staging:proxy && pnpm deploy:staging:tail && pnpm deploy:staging:api && pnpm deploy:staging:dispatch",
    "deploy:staging:api": "pnpm -F api migrate:staging && pnpm -F api run deploy --env staging",
    "deploy:staging:dashboard": "pnpm -F dashboard run deploy:staging",
    "deploy:staging:dispatch": "pnpm -F dispatch run deploy --env staging",
    "deploy:staging:proxy": "pnpm -F proxy run deploy --env staging",
    "deploy:staging:tail": "pnpm -F tail run deploy --env staging",
    "deploy:tail": "pnpm -F tail run deploy",
    "dev": "pnpm -F dashboard dev",
    "fmt": "oxfmt",
    "health": "node packages/api/scripts/health.ts",
    "health:staging": "node packages/api/scripts/health.ts --staging",
    "lint": "oxlint --type-aware --ignore-pattern 'framework/**'",
    "prepare": "husky",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.22.0",
    "playwright": "^1.59.1",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "void": "link:framework/packages/void",
      "@void/react": "link:framework/packages/react",
      "@void/vue": "link:framework/packages/vue"
    }
  }
}
