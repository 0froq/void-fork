{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest --run",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "check": "pnpm -r --parallel typecheck",
    "migrate": "cd packages/platform && wrangler d1 migrations apply vite-cloud-platform",
    "deploy": "pnpm deploy:dispatch && pnpm deploy:platform",
    "deploy:dispatch": "cd packages/dispatch && wrangler deploy",
    "deploy:platform": "pnpm migrate --remote && cd packages/platform && wrangler deploy",
    "deploy:docs": "pnpm deploy:mcp && cd packages/website && pnpm run deploy",
    "deploy:mcp": "cd packages/mcp && pnpm run deploy",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "typescript": "catalog:",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "vite": "catalog:"
    }
  }
}
