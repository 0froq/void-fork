{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -F dashboard dev",
    "build": "pnpm -F dashboard build",
    "test": "vitest --run",
    "lint": "oxlint --type-aware --ignore-pattern 'framework/**'",
    "fmt": "oxfmt",
    "check": "pnpm -r --parallel typecheck",
    "deploy": "pnpm deploy:ai-proxy && pnpm deploy:api && pnpm deploy:dispatch && pnpm deploy:dashboard",
    "deploy:ai-proxy": "pnpm -F /ai-proxy run deploy",
    "deploy:dispatch": "pnpm -F dispatch run deploy",
    "deploy:api": "pnpm -F api migrate && pnpm -F api run deploy",
    "deploy:dashboard": "pnpm -F dashboard run deploy",
    "deploy:staging": "pnpm deploy:staging:ai-proxy && pnpm deploy:staging:api && pnpm deploy:staging:dispatch && pnpm deploy:staging:dashboard",
    "deploy:staging:ai-proxy": "pnpm -F ai-proxy run deploy --env staging",
    "deploy:staging:dispatch": "pnpm -F dispatch run deploy --env staging",
    "deploy:staging:api": "pnpm -F api migrate:staging && pnpm -F api run deploy --env staging",
    "deploy:staging:dashboard": "pnpm -F dashboard run deploy:staging",
    "health": "node packages/api/scripts/health.ts",
    "health:staging": "node packages/api/scripts/health.ts --staging",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "oxlint-tsgolint": "^0.15.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "void": "link:framework/packages/void",
      "@void-x/vue": "link:framework/packages/vue"
    }
  }
}
