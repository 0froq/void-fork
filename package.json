{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest --run",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "check": "pnpm -r --parallel typecheck",
    "deploy": "pnpm deploy:ai-proxy && pnpm deploy:dispatch && pnpm deploy:platform && pnpm deploy:dashboard",
    "deploy:ai-proxy": "pnpm -F /ai-proxy run deploy",
    "deploy:dispatch": "pnpm -F dispatch run deploy",
    "deploy:platform": "pnpm -F platform migrate && pnpm -F platform run deploy",
    "deploy:dashboard": "pnpm -F dashboard run deploy",
    "deploy:staging": "pnpm deploy:staging:ai-proxy && pnpm deploy:staging:dispatch && pnpm deploy:staging:platform && pnpm deploy:staging:dashboard",
    "deploy:staging:ai-proxy": "pnpm -F ai-proxy run deploy --env staging",
    "deploy:staging:dispatch": "pnpm -F dispatch run deploy --env staging",
    "deploy:staging:platform": "pnpm -F platform migrate:staging && pnpm -F platform run deploy --env staging",
    "deploy:staging:dashboard": "pnpm -F dashboard run deploy:staging",
    "health": "node packages/platform/scripts/health.ts",
    "health:staging": "node packages/platform/scripts/health.ts --staging",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "vite-cloud": "link:framework/packages/vite-cloud",
      "@vite-cloud/vue": "link:framework/packages/vue"
    }
  }
}
