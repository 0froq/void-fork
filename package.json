{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:cli": "pnpm -F vite-cloud build",
    "build:docs": "pnpm -F website build",
    "test": "vitest --run",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "check": "pnpm -r --parallel typecheck",
    "docs": "cd packages/website && vitepress dev",
    "migrate": "pnpm -F platform migrate",
    "migrate:staging": "pnpm -F platform migrate:staging",
    "deploy": "pnpm deploy:dispatch && pnpm deploy:platform",
    "deploy:dispatch": "pnpm -F dispatch run deploy",
    "deploy:platform": "pnpm migrate --remote && pnpm -F platform run deploy",
    "deploy:staging": "pnpm deploy:staging:dispatch && pnpm deploy:staging:platform",
    "deploy:staging:dispatch": "pnpm -F dispatch run deploy --env staging",
    "deploy:staging:platform": "pnpm migrate:staging --remote && pnpm -F platform run deploy --env staging",
    "deploy:docs": "pnpm -F website run deploy",
    "deploy:staging:docs": "pnpm -F website run deploy --project vite-cloud-staging",
    "deploy:mcp": "pnpm -F mcp run deploy",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "vite": "catalog:"
    }
  }
}
