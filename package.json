{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:cli": "pnpm -F vite-cloud build",
    "build:docs": "pnpm -F docs build",
    "test": "vitest --run",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "check": "pnpm -r --parallel typecheck",
    "docs": "cd packages/docs && vitepress dev",
    "deploy:docs": "pnpm -F docs run deploy",
    "deploy:staging:docs": "pnpm -F docs run deploy --project vite-cloud-staging",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "playwright": "^1.58.2",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "vite": "catalog:"
    }
  }
}
