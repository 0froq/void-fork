{
  "name": "@vite-cloud/svelte",
  "version": "0.0.1",
  "files": [
    "dist",
    "src/runtime"
  ],
  "type": "module",
  "svelte": "./src/runtime/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./plugin": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./App.svelte": {
      "svelte": "./src/runtime/App.svelte",
      "default": "./src/runtime/App.svelte"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "svelte": "^5.53.2",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vite-cloud": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "catalog:",
    "vite-cloud": "workspace:*"
  }
