  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@cloudflare/vite-plugin": "^1.25.0",
    "better-sqlite3": "^12.6.2",
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "estree-walker": "^3.0.3",
    "tinyglobby": "^0.2.15",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.0-beta.14"
  }
