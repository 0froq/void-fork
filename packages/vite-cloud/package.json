{
  "name": "vite-cloud",
  "version": "0.0.1",
  "bin": {
    "vite-cloud": "dist/deploy/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
