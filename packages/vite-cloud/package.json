{
  "name": "vite-cloud",
  "version": "0.0.1",
  "bin": {
    "vcd": "dist/cli/cli.mjs",
    "vite-cloud": "dist/cli/cli.mjs"
  },
  "files": [
    "dist",
    "env.d.ts",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./handler": {
      "types": "./dist/runtime/handler.d.mts",
      "import": "./dist/runtime/handler.mjs"
    },
    "./response": {
      "types": "./dist/runtime/response.d.mts",
      "import": "./dist/runtime/response.mjs"
    },
    "./auth": {
      "types": "./dist/runtime/auth.d.mts",
      "import": "./dist/runtime/auth.mjs"
    },
    "./auth/session": {
      "types": "./dist/auth/session.d.mts",
      "import": "./dist/auth/session.mjs"
    },
    "./auth/password": {
      "types": "./dist/auth/password.d.mts",
      "import": "./dist/auth/password.mjs"
    },
    "./auth/schema": {
      "types": "./dist/auth/schema.d.mts",
      "import": "./dist/auth/schema.mjs"
    },
    "./env": {
      "types": "./env.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.0",
    "@cloudflare/workers-types": "catalog:",
    "@hono/oauth-providers": "^0.8.5",
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "estree-walker": "^3.0.3",
    "tinyglobby": "^0.2.15",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "vite": "^8.0.0-beta.14"
  }
}
