{
  "name": "vite-cloud",
  "version": "0.0.1",
  "bin": {
    "vcd": "dist/cli/cli.mjs",
    "vite-cloud": "dist/cli/cli.mjs"
  },
  "files": [
    "dist",
    "env.d.ts",
    "schema.json",
    "skills",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./handler": {
      "types": "./dist/runtime/handler.d.mts",
      "import": "./dist/runtime/handler.mjs"
    },
    "./response": {
      "types": "./dist/runtime/response.d.mts",
      "import": "./dist/runtime/response.mjs"
    },
    "./auth": {
      "types": "./dist/runtime/auth.d.mts",
      "import": "./dist/runtime/auth.mjs"
    },
    "./auth/session": {
      "types": "./dist/auth/session.d.mts",
      "import": "./dist/auth/session.mjs"
    },
    "./auth/password": {
      "types": "./dist/auth/password.d.mts",
      "import": "./dist/auth/password.mjs"
    },
    "./auth/schema": {
      "types": "./dist/auth/schema.d.mts",
      "import": "./dist/auth/schema.mjs"
    },
    "./validator": {
      "types": "./dist/runtime/validator.d.mts",
      "import": "./dist/runtime/validator.mjs"
    },
    "./routes": {
      "types": "./dist/routes-stub.d.mts"
    },
    "./client": {
      "types": "./dist/runtime/client.d.mts",
      "import": "./dist/runtime/client.mjs"
    },
    "./db": {
      "types": "./dist/runtime/db.d.mts",
      "import": "./dist/runtime/db.mjs"
    },
    "./kv": {
      "types": "./dist/runtime/kv.d.mts",
      "import": "./dist/runtime/kv.mjs"
    },
    "./storage": {
      "types": "./dist/runtime/storage.d.mts",
      "import": "./dist/runtime/storage.mjs"
    },
    "./isr": {
      "types": "./dist/runtime/isr.d.mts",
      "import": "./dist/runtime/isr.mjs"
    },
    "./env": {
      "types": "./env.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.0",
    "@cloudflare/workers-types": "catalog:",
    "@hono/oauth-providers": "^0.8.5",
    "better-sqlite3": "^12.6.2",
    "ofetch": "^1.5.1"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "arktype": "^2.1.29",
    "es-module-lexer": "^2.0.0",
    "estree-walker": "^3.0.3",
    "tinyglobby": "^0.2.15",
    "tsdown": "catalog:",
    "valibot": "^1.2.0",
    "vite": "catalog:",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "vite": "^8.0.0-beta.14"
  },
  "peerDependenciesMeta": {}
}
