{
  "name": "void-dashboard",
  "compatibility_date": "2026-02-12",
  "assets": {
    "directory": "dist/client",
  },
  "routes": [{ "pattern": "dash.void.cloud", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "void-api",
      "database_id": "b559aaf5-e70b-47f3-998e-af502abed7eb",
    },
  ],
  "env": {
    "staging": {
      "name": "void-dashboard-staging",
      "routes": [{ "pattern": "dash.staging.void.cloud", "custom_domain": true }],
      "vars": {
        "API_URL": "https://api.staging.void.cloud",
        "SITE_DOMAIN": "staging.vitecloud.app",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "void-api-staging",
          "database_id": "dd8eebb3-fe07-44dd-aadc-09675eb7b581",
        },
      ],
    },
  },
}
