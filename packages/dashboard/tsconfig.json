{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "types": ["void/env"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["pages", "routes", "middleware", "lib"]
}
