{
  "name": "void-tail",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-12",
  "observability": {
    "enabled": true,
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "void_logs",
    },
  ],
  "env": {
    "staging": {
      "name": "void-tail-staging",
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "void_logs_staging",
        },
      ],
    },
  },
}
