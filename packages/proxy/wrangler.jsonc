{
  "name": "void-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    {
      "binding": "ROUTING",
      "id": "9250c33f3db6494ebe8ad6272812c8c0",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "void-api",
      "database_id": "b559aaf5-e70b-47f3-998e-af502abed7eb",
    },
  ],
  // Secrets (via `wrangler secret put`): JWT_SECRET, CF_ACCOUNT_ID, CF_API_TOKEN
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "routes": [{ "pattern": "proxy.void.cloud", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "void-proxy-staging",
      "ai": { "binding": "AI" },
      "kv_namespaces": [
        {
          "binding": "ROUTING",
          "id": "60240eecea804f39bf8b7395cd6c6b08",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "void-api-staging",
          "database_id": "dd8eebb3-fe07-44dd-aadc-09675eb7b581",
        },
      ],
      "routes": [{ "pattern": "proxy.staging.void.cloud", "custom_domain": true }],
    },
  },
}
