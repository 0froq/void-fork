{
  "name": "vite-cloud-ai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    {
      "binding": "ROUTING",
      "id": "9250c33f3db6494ebe8ad6272812c8c0",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "routes": [{ "pattern": "ai-proxy.vite.cloud", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "vite-cloud-ai-proxy-staging",
      "ai": { "binding": "AI" },
      "kv_namespaces": [
        {
          "binding": "ROUTING",
          "id": "60240eecea804f39bf8b7395cd6c6b08",
        },
      ],
      "routes": [{ "pattern": "ai-proxy.staging.vite.cloud", "custom_domain": true }],
    },
  },
}
