{
  "name": "@voidcloud/api",
  "private": true,
  "type": "module",
  "exports": {
    "./db": "./src/db.ts",
    "./types": "./src/types.ts",
    "./id": "./src/id.ts",
    "./tiers": "./src/tiers.ts",
    "./auth/jwt": "./src/auth/jwt.ts",
    "./auth/dashboard": "./src/auth/dashboard.ts",
    "./auth/github": "./src/auth/github.ts",
    "./auth/google": "./src/auth/google.ts",
    "./usage": "./src/routes/usage.ts",
    "./api": "./src/api.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "drizzle-kit migrate",
    "migrate:staging": "DATABASE_URL=$STAGING_DATABASE_URL drizzle-kit migrate",
    "typecheck": "tsgo --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "setup": "node scripts/setup-local.ts"
  },
  "dependencies": {
    "cron-parser": "5.5.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "pg": "8.19.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@electric-sql/pglite": "0.3.15",
    "@types/pg": "8.16.0",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "^0.31.9",
    "miniflare": "^4",
    "wrangler": "catalog:"
  },
  "optionalDependencies": {
    "@clack/prompts": "^0.10.0"
  }
}
