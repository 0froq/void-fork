{
  "name": "@voidcloud/api",
  "private": true,
  "type": "module",
  "exports": {
    "./db": "./src/db.ts",
    "./types": "./src/types.ts",
    "./id": "./src/id.ts",
    "./tiers": "./src/tiers.ts",
