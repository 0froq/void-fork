{
  "name": "void-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "void-api",
      "database_id": "b559aaf5-e70b-47f3-998e-af502abed7eb",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "void-assets",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "ROUTING",
      "id": "9250c33f3db6494ebe8ad6272812c8c0",
    },
  ],
  "dispatch_namespaces": [
    {
      "binding": "DISPATCH",
      "namespace": "void-users",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USAGE_COUNTER",
        "class_name": "UsageCounter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["UsageCounter"],
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "void-usage-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
      },
    ],
  },
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "routes": [{ "pattern": "api.void.cloud", "custom_domain": true }],
  // Secrets (via `wrangler secret put`): CF_API_TOKEN, CF_ACCOUNT_ID, CF_ZONE_ID, JWT_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
  // Optional env var: AUTH_REDIRECT_URI (defaults to https://api.void.cloud/auth/callback)
  // For local dev, set AUTH_REDIRECT_URI=http://localhost:8787/auth/callback and DEV_AUTH_BYPASS=true in .dev.vars
  "env": {
    "staging": {
      "name": "void-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "void-api-staging",
          "database_id": "dd8eebb3-fe07-44dd-aadc-09675eb7b581",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "void-assets-staging",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "ROUTING",
          "id": "60240eecea804f39bf8b7395cd6c6b08",
        },
      ],
      "dispatch_namespaces": [
        {
          "binding": "DISPATCH",
          "namespace": "void-users-staging",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "USAGE_COUNTER",
            "class_name": "UsageCounter",
          },
        ],
      },
      "queues": {
        "consumers": [
          {
            "queue": "void-usage-events-staging",
            "max_batch_size": 100,
            "max_batch_timeout": 5,
          },
        ],
      },
      "routes": [{ "pattern": "api.staging.void.cloud", "custom_domain": true }],
      "vars": {
        "DISPATCH_NAMESPACE": "void-users-staging",
        "DISPATCH_WORKER_NAME": "void-dispatch-staging",
        "AI_PROXY_SERVICE": "void-ai-proxy-staging",
        "SITE_DOMAIN": "staging.voidcloud.dev",
        "DASHBOARD_URL": "https://dash.staging.void.cloud",
        "AUTH_REDIRECT_URI": "https://api.staging.void.cloud/auth/callback",
        "SIGNUP_ALLOWLIST": "@voidzero.dev",
      },
    },
  },
}
