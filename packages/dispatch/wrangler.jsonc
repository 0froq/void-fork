{
  "name": "vite-cloud-dispatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-12",
  "routes": [
    { "pattern": "*.vitecloud.app/*", "zone_name": "vitecloud.app" },
    { "pattern": "*/*", "zone_name": "vitecloud.app" },
  ],
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  "dispatch_namespaces": [
    {
      "binding": "DISPATCH",
      "namespace": "vite-cloud-users",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "vite-cloud-assets",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "ROUTING",
      "id": "9250c33f3db6494ebe8ad6272812c8c0",
    },
  ],
}
