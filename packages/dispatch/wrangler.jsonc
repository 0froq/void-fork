{
  "name": "void-dispatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-12",
  "routes": [
    { "pattern": "*.void.app/*", "zone_name": "void.app" },
    { "pattern": "*.void.app", "zone_name": "void.app" },
  ],
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  "dispatch_namespaces": [
    {
      "binding": "DISPATCH",
      "namespace": "void-users",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "void-assets",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "ROUTING",
      "id": "9250c33f3db6494ebe8ad6272812c8c0",
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "vite_cloud_requests",
    },
  ],
  "env": {
    "staging": {
      "name": "void-dispatch-staging",
      "routes": [
        { "pattern": "*.staging.void.app/*", "zone_name": "void.app" },
        { "pattern": "*.staging.void.app", "zone_name": "void.app" },
      ],
      "vars": {
        "BASE_HOSTNAME": "staging.void.app",
      },
      "dispatch_namespaces": [
        {
          "binding": "DISPATCH",
          "namespace": "void-users-staging",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "void-assets-staging",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "ROUTING",
          "id": "60240eecea804f39bf8b7395cd6c6b08",
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "vite_cloud_requests_staging",
        },
      ],
    },
  },
}
