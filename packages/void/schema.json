{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Void Configuration",
  "description": "Configuration file for void projects (void.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URL for IDE support"
    },
    "auth": {
      "description": "Enable built-in auth routes and session management. `true` enables email-only auth. An array enables specific providers.",
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["github", "google", "email"]
          },
          "uniqueItems": true
        }
      ]
    },
    "bindings": {
      "type": "object",
      "description": "Explicitly control inferred Cloudflare bindings. If omitted, bindings are inferred by scanning source files.",
      "properties": {
        "db": {
          "type": "boolean",
          "description": "Enable D1 database binding (c.env.DB)"
        },
        "kv": {
          "type": "boolean",
          "description": "Enable KV namespace binding (c.env.KV)"
        },
        "storage": {
          "type": "boolean",
          "description": "Enable R2 bucket binding (c.env.STORAGE)"
        }
      },
      "additionalProperties": false
    },
    "headers": {
      "type": "object",
      "description": "Custom response headers for static assets. Keys are URL patterns (e.g. \"/assets/*\"), values are arrays of \"Name: value\" strings.",
      "patternProperties": {
        "^/": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Header strings in \"Name: value\" format"
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": ["spa", "ssg", "fullstack", "framework"],
      "description": "Deployment mode. If omitted, auto-detected on first deploy."
    },
    "outputDir": {
      "type": "string",
      "description": "Output directory for static deploys. Relative to project root."
    },
    "cache": {
      "type": "object",
      "description": "Caching configuration.",
      "properties": {
        "revalidate": {
          "description": "Edge caching TTL in seconds. A number sets a global TTL for all SSR pages. An object maps URL patterns to TTLs (first match wins). Set to 0 to disable caching for a path.",
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "object",
              "patternProperties": {
                "^(/|\\*)": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "wrangler": {
      "type": "object",
      "description": "Curated wrangler config passthrough. Binding arrays (d1_databases, kv_namespaces, r2_buckets) are not allowed here — bindings are fully managed by void.",
      "properties": {
        "compatibility_date": {
          "type": "string",
          "description": "Cloudflare Workers compatibility date"
        },
        "compatibility_flags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Cloudflare Workers compatibility flags"
        },
        "vars": {
          "type": "object",
          "description": "Environment variables (plain text, not secrets)",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
