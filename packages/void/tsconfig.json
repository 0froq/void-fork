{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node", "@cloudflare/workers-types"],
    "isolatedDeclarations": true
  },
  "include": ["src", "test", "env.d.ts"],
  "exclude": [
    "src/runtime/vue.ts",
    "src/runtime/react.ts",
    "src/runtime/svelte.ts",
    "src/runtime/solid.ts"
  ]
}
