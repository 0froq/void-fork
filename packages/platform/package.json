{
  "name": "@vite-cloud/platform",
  "private": true,
  "type": "module",
  "exports": {
    "./db": "./src/db.ts",
    "./types": "./src/types.ts",
    "./id": "./src/id.ts",
    "./tiers": "./src/tiers.ts",
    "./auth/jwt": "./src/auth/jwt.ts",
    "./auth/github": "./src/auth/github.ts",
    "./auth/google": "./src/auth/google.ts",
    "./usage": "./src/routes/usage.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsgo --noEmit",
    "migrate": "wrangler d1 migrations apply vite-cloud-platform",
    "migrate:staging": "wrangler d1 migrations apply vite-cloud-platform-staging --env staging",
    "setup": "node scripts/setup-local.ts"
  },
  "dependencies": {
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@typescript/native-preview": "catalog:",
    "miniflare": "^4",
    "wrangler": "catalog:"
  },
  "optionalDependencies": {
    "@clack/prompts": "^0.10.0"
  }
}
