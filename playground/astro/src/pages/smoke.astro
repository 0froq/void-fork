---
export const prerender = false;

const runtime = Astro.locals.runtime;
const result = await runtime.env.DB.prepare("SELECT * FROM users LIMIT 1").first();
await runtime.env.KV.put("smoke", "ok");
const kvValue = await runtime.env.KV.get("smoke");
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Smoke Test</title>
  </head>
  <body>
    <h1>Smoke Test</h1>
    <p>D1 user: <span data-testid="d1-user">{result?.name ?? "none"}</span></p>
    <p>KV value: <span data-testid="kv-value">{kvValue ?? "none"}</span></p>
  </body>
</html>
