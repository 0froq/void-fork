---
export const prerender = false;

import { db } from "void/db";
import { kv } from "void/kv";

await db.raw("CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, name TEXT NOT NULL)");
await db.raw("INSERT OR IGNORE INTO users (id, name) VALUES (1, 'Alice')");

const rows = await db.raw<{ name: string }>("SELECT name FROM users LIMIT 1");
const result = rows[0] ?? null;

await kv.set("smoke", "ok");
const kvValue = await kv.get<string>("smoke");
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Smoke Test</title>
  </head>
  <body>
    <h1>Smoke Test</h1>
    <p>D1 user: <span data-testid="d1-user">{result?.name ?? "none"}</span></p>
    <p>KV value: <span data-testid="kv-value">{kvValue ?? "none"}</span></p>
  </body>
</html>
